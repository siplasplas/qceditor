@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Qt6 6.2 COMPONENTS Widgets)
find_dependency(qt-extra 2.7)
find_dependency(qcodeedit 1.63.0)
find_dependency(qcodeedit-kate 1.63.0)
find_dependency(qcodeedit-katedata 1.63.0)
find_dependency(qcodeedit-encoding 1.63.0)
find_dependency(qcodeedit-spell 1.63.0)
find_dependency(qcodeedit-spelldata 1.63.0)
find_dependency(qcodeedit-diff 1.63.0)
# Botan for encrypted .een files, the version the library was built with.
find_dependency(PkgConfig)
pkg_check_modules(QCEDITOR_BOTAN REQUIRED IMPORTED_TARGET @QCEDITOR_BOTAN_MODULE@)

include("${CMAKE_CURRENT_LIST_DIR}/qceditorTargets.cmake")

check_required_components(qceditor)
